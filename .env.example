# ==============================================================================
# Multi-Organization, Multi-Industry ERP & Business Management Platform
# Environment Template (.env.example)
# Copy this file to .env for local development. NEVER commit real .env files.
# ==============================================================================

# Application Runtime
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4000
CLIENT_PORT=3000
LOG_LEVEL=info

# Frontend Public Configuration (Safe to expose to browser)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# CORS Origin Allowlist (comma-separated)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PostgreSQL Connection (Replace placeholder password in local .env only)
DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/erp_platform_dev
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/erp_platform_test
# Optional non-superuser application runtime role URL (enforces PostgreSQL RLS)
DATABASE_APP_URL=postgresql://erp_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/erp_platform_dev
TEST_DATABASE_APP_URL=postgresql://erp_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/erp_platform_test
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Security & Sessions (MUST replace with 32+ random chars in non-dev environments)
SESSION_SECRET=dev-only-replace-with-secure-random-32-chars-minimum

# File Storage Adapter (ADR-008: 'local' for dev, 's3' for staging/prod)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
