{
  "name": "@platform/erp-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Professional Multi-Organization, Multi-Industry ERP & Business Management Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "node scripts/dev/start-dev.js",
    "build": "npm --workspace=client run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "policy:check": "node scripts/testing/verify-policy.js",
    "migrations:check": "node scripts/testing/check-migrations.js",
    "db:bootstrap": "node scripts/database/bootstrap.js",
    "db:migrate": "node scripts/database/migrate.js up",
    "db:migrate:test": "node scripts/database/migrate.js up --test",
    "db:rollback": "node scripts/database/migrate.js down",
    "db:status": "node scripts/database/migrate.js status",
    "audit:deps": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:phases": "node scripts/testing/run-phase-checks.js",
    "verify:fast": "node scripts/testing/run-fast-checks.js",
    "verify:full": "node scripts/testing/run-full-checks.js",
    "validate": "node scripts/testing/run-validate.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "vitest": "^5.1.2"
  }
}
